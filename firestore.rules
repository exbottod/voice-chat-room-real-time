rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Ganti dengan email developer/admin Anda
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == "bangexx01@gmail.com"
        && request.auth.token.email_verified == true;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if isOwner(uid) || isAdmin();
    }

    match /userIds/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /counters/{doc} {
      allow read, write: if signedIn();
    }

    match /wallets/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    // ---------- Ranking ----------
    match /rank_sawer/{docId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.subject == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /rank_room/{docId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    match /rank_charm/{docId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn();
      allow delete: if signedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());

      match /{sub=**} {
        allow read, write: if signedIn();
      }
    }

    match /invites/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid);
      allow update, delete: if isAdmin();
    }

    match /follows/{docId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.followerUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.followerUid == request.auth.uid;
      allow update: if false;
    }

    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create, update: if signedIn() && request.auth.uid in request.resource.data.members;

      match /messages/{msgId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
          && request.resource.data.from == request.auth.uid;
      }
    }

    match /moments/{momentId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn();
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());

      match /likes/{uid} {
        allow read: if signedIn();
        allow create, delete: if isOwner(uid);
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      }
    }

    match /vipConfig/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /banners/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /banned/{uid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /adminLogs/{id} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
